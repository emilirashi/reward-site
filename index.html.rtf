                    <p class="text-[15px] font-normal text-gray-300 leading-snug">"Totally legit. Followed the instructions and got my reward within 48 hours. Ready for spooky season!"</p>
                </div>
            </div>

            <!-- GREEN SQUARE CHECKBOX FOOTER -->
            <div class="mt-6 mb-2 flex items-center justify-center gap-2 text-[13px] font-medium text-gray-400">
                <div class="w-5 h-5 bg-[#31c440] rounded flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span>12,400+ gift cards claimed this month</span>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('cta-link').href = CONFIG.affiliateLink;

        function toggleFAQ() {
            const content = document.getElementById('faq-content');
            const arrow = document.getElementById('faq-arrow');
            content.classList.toggle('collapsed');
            arrow.classList.toggle('rotated');
        }

        const notifications = [
            { name: "Lisa M.", deals: "8", amount: "$100", location: "California" },
            { name: "Mike R.", deals: "20", amount: "$100", location: "Florida" },
            { name: "Chris P.", deals: "12", amount: "$100", location: "Ohio" },
            { name: "Nicole H.", deals: "10", amount: "$100", location: "Illinois" },
            { name: "John D.", deals: "5", amount: "$100", location: "Texas" },
            { name: "Sarah K.", deals: "4", amount: "$100", location: "New York" }
        ];

        const popup = document.getElementById('notification-popup');

        function showNotification() {
            const data = notifications[Math.floor(Math.random() * notifications.length)];
            document.getElementById('notif-avatar').textContent = data.name.charAt(0);
            document.getElementById('notif-name').textContent = data.name;
            document.getElementById('notif-amount').textContent = data.amount;
            document.getElementById('notif-location').textContent = data.location;
            popup.classList.add('show');
            setTimeout(() => {
                popup.classList.remove('show');
                setTimeout(showNotification, 5000 + Math.random() * 3000);
            }, 4000);
        }
        setTimeout(showNotification, 3000);
    </script>
</body>
</html>
